# Production images only need the four Go modules and their Dockerfiles.
# Start by excluding everything, then explicitly reopen required directories.
**

!gateway/
!gateway/**
!admin/
!admin/**
!user/
!user/**
!web3/
!web3/**

!frontend/
frontend/**
!frontend/user/
!frontend/user/**
!frontend/admin/
!frontend/admin/**

!deploy/
deploy/**
!deploy/production/
deploy/production/**
!deploy/production/docker/
!deploy/production/docker/**
!deploy/production/nginx/
!deploy/production/nginx/user-web.conf
!deploy/production/nginx/admin-web.conf

# Local runtime artifacts inside the reopened module directories.
**/logs/
**/.gocache/
**/.gotmp/
**/node_modules/
**/.expo/
**/dist/

