# 复制为服务器上的 /opt/grpc-go/env/production.env，禁止提交真实密钥。
# 域名只填写主机名，不带 https:// 和路径。
ROOT_DOMAIN=example.com
USER_WEB_DOMAIN=app.example.com
ADMIN_WEB_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
KEYCLOAK_DOMAIN=auth.example.com

# Public URLs consumed by browsers and token issuer validation.
USER_WEB_ORIGIN=https://app.example.com
ADMIN_WEB_ORIGIN=https://admin.example.com
ADMIN_BFF_PUBLIC_URL=https://admin.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com
PUBLIC_BIND_ADDRESS=127.0.0.1
OAUTH2_COOKIE_SECURE=true

# Docker image and server paths
GO_VERSION=1.26.2
IMAGE_PREFIX=grpc-go
IMAGE_TAG=latest
# Absolute path on the Linux server. Do not place private keys in Git.
MTLS_CERTS_DIR=/opt/grpc-go/secrets/mtls

# Keycloak
KEYCLOAK_HOSTNAME=auth.example.com
KEYCLOAK_DB_PASSWORD=replace-with-strong-random-password
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-random-password
USER_WEB_CLIENT_SECRET=replace-with-keycloak-user-web-secret
ADMIN_WEB_CLIENT_SECRET=replace-with-keycloak-admin-web-secret
ADMIN_KEYCLOAK_CLIENT_SECRET=replace-with-admin-management-secret

# OAuth2 Proxy。两个 Cookie Secret 必须不同。
USER_COOKIE_SECRET=replace-with-random-cookie-secret
ADMIN_COOKIE_SECRET=replace-with-another-random-cookie-secret

# 数据库、Redis、RabbitMQ
ADMIN_DB_PASSWORD=replace-with-strong-random-password
USER_DB_PASSWORD=replace-with-strong-random-password
LLM_DB_PASSWORD=replace-with-strong-random-password
WEB3_DB_PASSWORD=replace-with-strong-random-password
REDIS_PASSWORD=replace-with-strong-random-password
RABBITMQ_PASSWORD=replace-with-strong-random-password

# Application runtime secrets
GATEWAY_ANTI_REPLAY_SECRET=replace-with-at-least-32-random-characters
USER_SNOWFLAKE_NODE_ID=1

# Consul ACL（未启用 ACL 时暂时留空）。
GATEWAY_CONSUL_TOKEN=
ADMIN_CONSUL_TOKEN=
USER_CONSUL_TOKEN=
LLM_CONSUL_TOKEN=
WEB3_CONSUL_TOKEN=

# Web3 上游密钥。功能关闭时可留空。
WEB3_TRON_API_KEY=
WEB3_TRON_USAGE_HMAC_KEY=replace-with-at-least-32-random-characters

