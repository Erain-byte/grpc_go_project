{
  "version": 1,
  "rate_limit": {
    "enabled": true,
    "redis_timeout": "300ms",
    "key_prefix": "admin:rate_limit:",
    "login": {
      "limit": 10,
      "window": "1m"
    },
    "refresh_token": {
      "limit": 20,
      "window": "1m"
    },
    "default": {
      "limit": 100,
      "window": "1m"
    }
  },
  "rabbitmq": {
    "operation_log_enabled": true,
    "max_retries": 3,
    "retry_delay": "5s"
  },
  "database": {
    "slow_query_threshold": "200ms"
  }
}
